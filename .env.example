# FloodLens Configuration

# Backend API endpoint (defaults to /api when proxied by Vite dev server)
VITE_API_URL="/api"

# Cesium Ion Access Token (Optional)
# If omitted or empty, FloodLens automatically falls back to OpenStreetMap / CartoDB raster tiles
# and WGS84 Ellipsoid terrain with zero errors.
VITE_CESIUM_TOKEN=""

# Server Port Configuration
PORT=3000
BACKEND_PORT=8000
